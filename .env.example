# ===================================================
# BACKEND ENVIRONMENT TEMPLATE (.env.example)
# ===================================================
NODE_ENV=development
PORT=8000

# MongoDB Connection String Format:
# mongodb+srv://<username>:<password>@<cluster-host>/<database_name>?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/employee_db?retryWrites=true&w=majority"

# Allowed CORS Origin (URL of your frontend app)
CORS_ORIGIN="http://localhost:5173"
